{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/prefix-budget.mjs\"",
            "timeout": 20,
            "statusMessage": "Measuring prefix budget"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/read-context-guard.mjs\"",
            "timeout": 15,
            "statusMessage": "Checking Read context budget"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/read-context-guard.mjs\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/bash-dump-guard.mjs\"",
            "timeout": 15,
            "statusMessage": "Evaluating Bash output budget"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/session-economy.mjs\"",
            "timeout": 20
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/read-context-guard.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/session-economy.mjs\"",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/read-context-guard.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/session-economy.mjs\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
